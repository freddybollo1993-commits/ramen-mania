{
  "cleanUrls": true,
  "framework": null,
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "shimaya-panel.vercel.app" }], "destination": "/panel/", "permanent": false },
    { "source": "/panel/:path*", "has": [{ "type": "host", "value": "ramen-mania.vercel.app" }], "destination": "https://shimaya-panel.vercel.app/panel/:path*", "permanent": false },
    { "source": "/dashboard", "destination": "https://shimaya-panel.vercel.app/panel/", "permanent": false },
    { "source": "/dashboard.html", "destination": "https://shimaya-panel.vercel.app/panel/", "permanent": false },
    { "source": "/admin", "destination": "https://shimaya-panel.vercel.app/panel/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/panel/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }]
    },
    {
      "source": "/panel/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
